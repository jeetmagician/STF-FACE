# ============================================================================
# Facet configuration
#
# Copy to .env and adjust. Every value has a working default; nothing here is
# required for local development.
# ============================================================================

# --- Application -----------------------------------------------------------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
APP_NAME=Facet

# --- Ports -----------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Security --------------------------------------------------------------
# If set, every /api/* request except /api/health must send X-API-Key.
# Leave empty only for local development.
API_KEY=

CORS_ORIGINS=http://localhost:3000

MAX_UPLOAD_BYTES=12582912        # 12 MB per file
MAX_FILES_PER_SIDE=5
MAX_IMAGE_PIXELS=50000000        # decompression-bomb guard
MAX_IMAGE_DIMENSION=8000
MIN_IMAGE_DIMENSION=64

RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANALYZE_REQUESTS=10
RATE_LIMIT_ANALYZE_WINDOW_SECONDS=60

# --- Model -----------------------------------------------------------------
# auto        : InsightFace if available, else OpenCV
# opencv      : YuNet + SFace. Apache-2.0, commercially licensable. DEFAULT.
# insightface : SCRFD + ArcFace R50. More accurate on hard pairs, but the
#               pretrained weights are NON-COMMERCIAL RESEARCH USE ONLY.
MODEL_BACKEND=opencv
USE_GPU=false
INSIGHTFACE_PACK=buffalo_l
INSIGHTFACE_DET_SIZE=640
DETECTION_CONFIDENCE_THRESHOLD=0.60
MAX_FACES_RETURNED=8

# --- Quality gates ---------------------------------------------------------
# An image failing any hard gate produces a refusal, not a score. Advisory
# values produce a warning attached to the result.
MIN_FACE_WIDTH_PX=60
ADVISORY_FACE_WIDTH_PX=110
MIN_BLUR_SCORE=18.0
ADVISORY_BLUR_SCORE=45.0
MAX_ABS_YAW_DEG=45.0
ADVISORY_ABS_YAW_DEG=25.0
MAX_ABS_PITCH_DEG=35.0
MAX_POSE_DIFFERENCE_DEG=50.0
ADVISORY_POSE_DIFFERENCE_DEG=25.0
MIN_EXPOSURE_SCORE=0.20
ADVISORY_EXPOSURE_SCORE=0.45
MIN_QUALITY_SCORE=30.0
ADVISORY_QUALITY_SCORE=55.0

# Occlusion heuristics
SUNGLASSES_DARKNESS_RATIO=0.55
MASK_TEXTURE_RATIO=0.42

# --- Scoring and calibration ----------------------------------------------
# Loads assets/calibration/<backend>.<profile>.json. If absent, unvalidated
# defaults are used and every response is flagged accordingly.
CALIBRATION_PROFILE=default

# Prior probability that a submitted pair is genuine.
#
# This is NOT an empirical base rate. 0.5 is deliberately neutral. Set it to
# reflect how your pairs are actually selected: a document-renewal queue where
# most pairs really are the same person warrants a high prior; two unrelated
# social media accounts warrant a low one. The likelihood ratio reported
# alongside the percentage does not depend on this value.
PRIOR_SAME_PERSON=0.5

# Band boundaries on the calibrated 0-100 scale.
BAND_VERY_HIGH=85.0
BAND_HIGH=70.0
BAND_MODERATE=45.0

# --- Ephemeral image retention --------------------------------------------
# Decoded images are held in memory only while a user picks between several
# detected faces. Never written to disk. Set false to disable entirely, at the
# cost of requiring a re-upload after face selection.
RETAIN_FOR_FACE_SELECTION=true
SESSION_TTL_SECONDS=300
SESSION_MAX_ENTRIES=200
