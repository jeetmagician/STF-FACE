// Copy this file to secrets.h and fill in your real values.
// secrets.h is gitignored - it never gets committed.

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// The Facet backend's LAN address - NOT localhost/127.0.0.1, since that
// means "this device itself" and the ESP32 is a different device on the
// network. Find your server's LAN IP with `ipconfig getifaddr en0` (Wi-Fi)
// or `en1` (Ethernet) on macOS, then run the backend with
// `--host 0.0.0.0` so it actually accepts connections from other devices.
#define SERVER_URL "http://192.168.1.50:8000/api/database-search/device-capture"

// A short label for this device - shows up in the /live page and in the
// capture log so you can tell devices apart if you build more than one.
#define DEVICE_ID "esp32-cam-1"

// Only needed if the backend has API_KEY set (backend/.env). Leave empty
// otherwise - an empty key is simply not sent.
#define API_KEY ""
