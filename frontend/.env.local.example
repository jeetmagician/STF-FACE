# Base URL of the Facet backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. Must match API_KEY on the backend.
#
# SECURITY NOTE: anything prefixed NEXT_PUBLIC_ is embedded in the JavaScript
# bundle and is therefore visible to anyone who loads the page. It is fine for
# a local prototype, but for a public deployment do not put a real secret here.
# Proxy API calls through a Next.js route handler that holds the key
# server-side instead. See docs/DEPLOYMENT.md.
# NEXT_PUBLIC_API_KEY=
